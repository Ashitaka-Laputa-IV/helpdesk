# 对话模型（provider:model + OpenAI 兼容 base_url，含 /v1）
MODEL=openai:qwen3-4b-instruct
OPENAI_API_BASE=http://127.0.0.1:9938/v1

# API key（本地服务可填任意值）
OPENAI_API_KEY=not-needed

# 嵌入模型
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:9931/v1

# 重排模型（langchain-reranker 的 llama_server provider）
RERANKER_MODEL=llama_server:bge-reranker
RERANKER_BASE_URL=http://127.0.0.1:9932

# Router 模式：rule（0ms 规则，默认）| llm（LLM 判断，建议配非思考小模型）
ROUTER_MODE=llm
# Router 专用模型与服务地址；不配则复用 MODEL / OPENAI_API_BASE
ROUTER_MODEL=openai:qwen3-4b-instruct
ROUTER_BASE_URL=http://127.0.0.1:9938/v1
