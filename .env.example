# 对话模型（provider:model + OpenAI 兼容 base_url，含 /v1）
MODEL=openai:lfm2.5-1.2b
OPENAI_API_BASE=http://127.0.0.1:9933/v1

# API key（本地服务可填任意值）
OPENAI_API_KEY=not-needed

# 嵌入模型
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:9931/v1

# 重排模型（langchain-reranker 的 llama_server provider）
RERANKER_MODEL=llama_server:bge-reranker
RERANKER_BASE_URL=http://127.0.0.1:9932
